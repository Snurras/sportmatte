rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts that may remove records. Keep in sync with ADMIN_UIDS in public/index.html.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['sE6TcKfC2rgOtwPCN56Xdu0d2em2'];
    }

    // Each child's own progress: only they can read and write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared scoreboard: one best score per child per level.
    // Everyone logged in can read it; you can only write your own row.
    match /boards/{level}/best/{uid} {
      allow read: if request.auth != null;
      // Admins (and the owner) may remove a row from the scoreboard.
      allow delete: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'points', 'ts'])
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 500
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
