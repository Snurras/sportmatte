rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each child's own progress: only they can read and write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared scoreboard: one best score per child per level.
    // Everyone logged in can read it; you can only write your own row.
    match /boards/{level}/best/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'points', 'ts'])
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 500
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
